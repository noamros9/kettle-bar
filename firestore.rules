rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own data, in these four collections and no others:
    // progress (per program), programs (your own), random (random workouts) and prefs (preferences).
    match /users/{uid}/{collection}/{doc} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && collection in ['progress', 'programs', 'random', 'prefs'];
    }
  }
}
